{"uuid":"55ff7ce7-10cf-44b3-9450-0f3aa5ad4eeb","header":[{"texts":[{"text":"Okresní soud v Prachaticích rozhodl soudkyní JUDr. ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"},{"text":" ve věci","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"žalobce: ","anonStyle":"NONE"},{"text":"osobní údaje žalobce","anonStyle":"ANON"},{"text":" zastoupen advokátkou (anonymizováno) (jméno) (příjmení) (příjmení)","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"se sídlem (adresa)","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"proti","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"žalovanému: ","anonStyle":"NONE"},{"text":"osobní údaje žalovaného","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"o zaplacení ","anonStyle":"NONE"},{"text":"částka","anonStyle":"ANON"},{"text":" s příslušenstvím","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null}],"verdict":[{"texts":[{"text":"I. Žalovaný je povinen zaplatit žalobci do tří dnů od právní moci tohoto rozsudku částku ","anonStyle":"NONE"},{"text":"částka","anonStyle":"ANON"},{"text":" s úrokem z prodlení ve výši 8,05 % ročně z částky ","anonStyle":"NONE"},{"text":"částka","anonStyle":"ANON"},{"text":" od ","anonStyle":"NONE"},{"text":"datum","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"do zaplacení.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"II. Žalovaný je povinen zaplatit žalobci na náhradě nákladů řízení částku ","anonStyle":"NONE"},{"text":"částka","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"do tří dnů od právní moci tohoto rozsudku k rukám zástupkyně žalobce.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"verdictText":"I. Žalovaný je povinen zaplatit žalobci do tří dnů od právní moci tohoto rozsudku částku [částka] s úrokem z prodlení ve výši 8,05 % ročně z částky [částka] od [datum]\rdo zaplacení.\nII. Žalovaný je povinen zaplatit žalobci na náhradě nákladů řízení částku [částka]\rdo tří dnů od právní moci tohoto rozsudku k rukám zástupkyně žalobce.","justification":[{"texts":[],"styleLocalId":0,"tableCellInfo":null}],"justificationText":"","information":[{"texts":[{"text":"Proti tomuto rozsudku, kterým bylo rozhodnuto o peněžitém plnění nepřevyšujícím","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"částka","anonStyle":"ANON"},{"text":", přičemž k příslušenství pohledávky se nepřihlíží, není odvolání přípustné.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Nebudou-li povinnosti uložené tímto rozsudkem splněny dobrovolně, lze je na návrh vykonat výkonem rozhodnutí či exekucí.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"metadata":{"type":"JUDGEMENT","ecli":"ECLI:CZ:OSPT:2020:2.C.219.2020.1","publishedAt":"2021-01-14","decisionAt":"2020-12-28","caseNumber":{"senate":2,"registry":"C","index":219,"year":2020,"pageNumber":11},"solver":{"titlesBefore":"JUDr.","firstName":"Vladislava","lastName":"Halodová soudkyně","titlesAfter":"","function":""},"courtCode":"OSPT","caseResultType":["VYHOVENI"],"caseSubject":"o zaplacení [částka] s příslušenstvím","specialType":[],"affectedDocs":[],"regulations":[],"flags":["PENEZITE_PLNENI"]},"styles":[{"localId":0,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":false,"italic":false},{"localId":1,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":true,"italic":false}]}