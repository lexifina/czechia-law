t":", a ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"celé jméno partnera","anonStyle":"ANON"},{"text":", uzavřené dne ","anonStyle":"NONE"},{"text":"datum","anonStyle":"ANON"},{"text":" před Úřadem ","anonStyle":"NONE"},{"text":"název","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"název","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"obec","anonStyle":"ANON"},{"text":" – ","anonStyle":"NONE"},{"text":"název","anonStyle":"ANON"},{"text":", se zrušuje.","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null},{"texts":[{"text":"II. Žádný z účastníků nemá právo na náhradu nákladů řízení.","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null}],"verdictText":"<b>I. Registrované partnerství [celé jméno partnera], rozeného [jméno], a [jméno] [jméno] [celé jméno partnera], uzavřené dne [datum] před Úřadem [název] [název] [obec] – [název], se zrušuje.</b>\n<b>II. Žádný z účastníků nemá právo na náhradu nákladů řízení.</b>","justification":[{"texts":[{"text":"Návrhem ze dne ","anonStyle":"NONE"},{"text":"datum","anonStyle":"ANON"},{"text":" domáhal se ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"celé jméno partnera","anonStyle":"ANON"},{"text":" zrušení registrovaného partnerství s odůvodněním, že toto fakticky netrvá. ","anonStyle":"NONE"},{"text":"celé jméno partnera","anonStyle":"ANON"},{"text":" se k návrhu připojil.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Z dokladu o registrovaném partnerství vzal soud za prokázáno, že toto účastníci uzavřeli ","anonStyle":"NONE"},{"text":"datum","anonStyle":"ANON"},{"text":" před Úřadem ","anonStyle":"NONE"},{"text":"název","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"název","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"obec","anonStyle":"ANON"},{"text":" – ","anonStyle":"NONE"},{"text":"název","anonStyle":"ANON"},{"text":". S ohledem na skutečnost, že druhý partner ","anonStyle":"NONE"},{"text":"celé jméno partnera","anonStyle":"ANON"},{"text":" se k návrhu připojil, soud dle § 17 zákona 115/2006 Sb. nezkoumal, zda partnerský vztah fakticky netrvá, a rozhodl o zrušení partnerství. Výrok II je odůvodněn § 23 zákona 292/2013 Sb. o zvláštních řízeních soudních.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"justificationText":"Návrhem ze dne [datum] domáhal se [jméno] [jméno] [celé jméno partnera] zrušení registrovaného partnerství s odůvodněním, že toto fakticky netrvá. [celé jméno partnera] se k návrhu připojil.\nZ dokladu o registrovaném partnerství vzal soud za prokázáno, že toto účastníci uzavřeli [datum] před Úřadem [název] [název] [obec] – [název]. S ohledem na skutečnost, že druhý partner [celé jméno partnera] se k návrhu připojil, soud dle § 17 zákona 115/2006 Sb. nezkoumal, zda partnerský vztah fakticky netrvá, a rozhodl o zrušení partnerství. Výrok II je odůvodněn § 23 zákona 292/2013 Sb. o zvláštních řízeních soudních.","information":[{"texts":[{"text":"Proti tomuto rozsudku není odvolání přípustné (§ 399 odst. 2 vě spojení s § 395 zákona 292/2013 Sb.).","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"metadata":{"type":"JUDGEMENT","ecli":"ECLI:CZ:MSBR:2020:21.C.209.2020.1","publishedAt":"2021-02-08","decisionAt":"2020-12-02","caseNumber":{"senate":21,"registry":"C","index":209,"year":2020,"pageNumber":30},"solver":{"titlesBefore":"JUDr.","firstName":"Hana","lastName":"Šťastná","titlesAfter":"","function":""},"courtCode":"MSBR","caseResultType":["VYHOVENI"],"caseSubject":"zrušení registrovaného partnerství","specialType":[],"affectedDocs":[],"regulations":[{"paragraphNumber":"23","lexNumber":292,"lexYear":2013,"lexType":"PREDPIS_ZAKON"},{"paragraphNumber":"395","lexNumber":292,"lexYear":2013,"lexType":"PREDPIS_ZAKON"},{"paragraphNumber":"17","lexNumber":115,"lexYear":2006,"lexType":"PREDPIS_ZAKON"}],"flags":[]},"styles":[{"localId":0,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":false,"italic":false},{"localId":1,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":true,"italic":false}]}