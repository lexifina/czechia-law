{"uuid":"f059c0d5-2cd6-4349-879a-b83de09ffef5","header":[{"texts":[{"text":"Městský soud v Brně rozhodl samosoudkyní JUDr. Hanou Šťastnou ve věci","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"partnerka:","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"a;","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"celé jméno partnerky","anonStyle":"ANON"},{"text":", ","anonStyle":"NONE"},{"text":"datum narození","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"bytem ","anonStyle":"NONE"},{"text":"adresa partnerky","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"zastoupená advokátem ","anonStyle":"NONE"},{"text":"titul","anonStyle":"ANON"},{"text":". ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"sídlem ","anonStyle":"NONE"},{"text":"adresa","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"partnerka: ","anonStyle":"NONE"},{"text":"celé jméno partnerky","anonStyle":"ANON"},{"text":", ","anonStyle":"NONE"},{"text":"datum narození","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"bytem ","anonStyle":"NONE"},{"text":"adresa partnerky","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"zastoupená advokátem ","anonStyle":"NONE"},{"text":"titul","anonStyle":"ANON"},{"text":". ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"sídlem ","anonStyle":"NONE"},{"text":"adresa","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"o zrušení registrovaného partnerství","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null}],"verdict":[{"texts":[{"text":"I. Registrované partnerství ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"},{"text":" a ","anonStyle":"NONE"},{"text":"jméno","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"},{"text":", rozené ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"},{"text":", uzavřené dne ","anonStyle":"NONE"},{"text":"datum","anonStyle":"ANON"},{"text":" před ","anonStyle":"NONE"},{"text":"anonymizována tři slova","anonStyle":"ANON"},{"text":" ","anonStyle":"NONE"},{"text":"obec","anonStyle":"ANON"},{"text":" – ","anonStyle":"NONE"},{"text":"anonymizováno","anonStyle":"ANON"},{"text":", se zrušuje.","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null},{"texts":[{"text":"II. Žádný z účastníků nemá právo na náhradu nákladů řízení.","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null}],"verdictText":"<b>I. Registrované partnerství [jméno] [příjmení] a [jméno] [příjmení], rozené [příjmení], uzavřené dne [datum] před [anonymizována tři slova] [obec] – [anonymizováno], se zrušuje.</b>\n<b>II. Žádný z účastníků nemá právo na náhradu nákladů řízení.</b>","justification":[{"texts":[{"text":"Návrhem z 30.4.2021 domáhala se ","anonStyle":"NONE"},{"text":"celé jméno partnerky","anonStyle":"ANON"},{"text":" zrušení registrovaného partnerství s odůvodněním, že partnerský vztah fakticky netrvá. Partnerka ","anonStyle":"NONE"},{"text":"celé jméno partnerky","anonStyle":"ANON"},{"text":" se k návrhu připojila.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Z dokladu o registrovaném partnerství vzal soud za prokázáno, že partnerství účastníků bylo uzavřeno 13.6.2020.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"S ohledem na to, že druhá partnerka se k návrhu na zrušení partnerství připojila, soud dle § 17 zákona 115/2006 o registrovaném partnerství nezkoumal, zda partnerský vztah již fakticky netrvá, a návrhu bez dalšího vyhověl. O nákladech řízení bylo rozhodnuto analogicky dle § 23 zákona 292/2013 Sb. o zvláštních řízeních soudních.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"justificationText":"Návrhem z 30.4.2021 domáhala se [celé jméno partnerky] zrušení registrovaného partnerství s odůvodněním, že partnerský vztah fakticky netrvá. Partnerka [celé jméno partnerky] se k návrhu připojila.\nZ dokladu o registrovaném partnerství vzal soud za prokázáno, že partnerství účastníků bylo uzavřeno 13.6.2020.\nS ohledem na to, že druhá partnerka se k návrhu na zrušení partnerství připojila, soud dle § 17 zákona 115/2006 o registrovaném partnerství nezkoumal, zda partnerský vztah již fakticky netrvá, a návrhu bez dalšího vyhověl. O nákladech řízení bylo rozhodnuto analogicky dle § 23 zákona 292/2013 Sb. o zvláštních řízeních soudních.","information":[{"texts":[{"text":"Proti tomuto rozhodnutí není odvolání přípustné (§ 399 odst. 2 ve spojení s § 395 zákona 292/2013 Sb.).","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"metadata":{"type":"JUDGEMENT","ecli":"ECLI:CZ:MSBR:2021:21.C.100.2021.1","publishedAt":"2021-07-14","decisionAt":"2021-05-19","caseNumber":{"senate":21,"registry":"C","index":100,"year":2021,"pageNumber":13},"solver":{"titlesBefore":"JUDr.","firstName":"Hana","lastName":"Šťastná","titlesAfter":"","function":""},"courtCode":"MSBR","caseResultType":["VYHOVENI"],"caseSubject":"zrušení registrovaného partnerství","specialType":[],"affectedDocs":[],"regulations":[{"paragraphNumber":"23","lexNumber":292,"lexYear":2013,"lexType":"PREDPIS_ZAKON"},{"paragraphNumber":"395","lexNumber":292,"lexYear":2013,"lexType":"PREDPIS_ZAKON"}],"flags":[]},"styles":[{"localId":0,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":false,"italic":false},{"localId":1,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":true,"italic":false}]}