{"uuid":"f18ffa03-a118-45b0-a0ce-b313c31f9eb9","header":[{"texts":[{"text":"Okresní soud v Hradci Králové rozhodl soudcem Mgr. Jindřichem Rajmanem ve věci","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"manželky: ; ","anonStyle":"NONE"},{"text":"celé jméno podatelky","anonStyle":"ANON"},{"text":", rozená ","anonStyle":"NONE"},{"text":"příjmení","anonStyle":"ANON"},{"text":", ","anonStyle":"NONE"},{"text":"datum narození","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"; bytem ","anonStyle":"NONE"},{"text":"adresa podatelky","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"a","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"manžela: ; ","anonStyle":"NONE"},{"text":"celé jméno podatela","anonStyle":"ANON"},{"text":", ","anonStyle":"NONE"},{"text":"datum narození","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"; bytem ","anonStyle":"NONE"},{"text":"adresa podatela","anonStyle":"ANON"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"o rozvodu manželství:","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"I. Manželství účastníků uzavřené dne 22. 6. 2001 ve ","anonStyle":"NONE"},{"text":"obec","anonStyle":"ANON"},{"text":" se rozvádí.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"II. Žádný z účastníků nemá právo na náhradu nákladů řízení.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Odůvodnění:","anonStyle":"NONE"}],"styleLocalId":1,"tableCellInfo":null},{"texts":[{"text":"Manželka podala návrh na rozvod manželství (§ 384 odst. 1 zákona o zvláštních řízeních soudních /dále jen „z. ř. s.“ /).","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Manžel s návrhem souhlasil.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Okresní soud vyšel ze zjištění, že manželství účastníků je pouze formálním svazkem neplnící svůj společenský účel. Účastníci nevedou společnou domácnost, ani k sobě nemají vzájemný kladný citový vztah. S ohledem na postoje účastníků není naděje, že by mohlo dojít k obnovení manželského soužití.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Soud proto návrhu na rozvod manželství vyhověl a manželství účastníků podle § 755 odst. 1 občanského zákoníku / ","anonStyle":"NONE"},{"text":"číslo","anonStyle":"ANON"},{"text":" rozvedl.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Jako primární příčinu rozvratu manželství soud spatřuje neslučitelnost životních očekávání.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"O nákladech řízení bylo rozhodnuto podle § 23 z. ř. s., podle kterého v řízení o rozvod manželství nemají účastníci právo na náhradu nákladů řízení.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"verdict":[{"texts":[],"styleLocalId":0,"tableCellInfo":null}],"verdictText":"","justification":[{"texts":[],"styleLocalId":0,"tableCellInfo":null}],"justificationText":"","information":[{"texts":[{"text":"Proti tomuto rozsudku lze podat odvolání do 15 dnů ode dne doručení jeho písemného vyhotovení ke Krajskému soudu v Hradci Králové prostřednictvím Okresního soudu v Hradci Králové.","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null},{"texts":[{"text":"Manžel, který přijal příjmení druhého manžela, může do 6 měsíců po rozvodu manželství oznámit matričnímu úřadu, že přijímá opět své dřívější příjmení (§ 759 občanského zákoníku).","anonStyle":"NONE"}],"styleLocalId":0,"tableCellInfo":null}],"metadata":{"type":"JUDGEMENT","ecli":"ECLI:CZ:OSHK:2021:9.C.32.2021.1","publishedAt":"2021-04-12","decisionAt":"2021-03-10","caseNumber":{"senate":9,"registry":"C","index":32,"year":2021,"pageNumber":12},"solver":{"titlesBefore":"Mgr.","firstName":"Jindřich","lastName":"Rajman","titlesAfter":"","function":""},"courtCode":"OSHK","caseResultType":["VYHOVENI"],"caseSubject":"rozvod manželství","specialType":[],"affectedDocs":[],"regulations":[{"paragraphNumber":"755","lexNumber":89,"lexYear":2012,"lexType":"PREDPIS_ZAKON"},{"paragraphNumber":"759","lexNumber":89,"lexYear":2012,"lexType":"PREDPIS_ZAKON"},{"paragraphNumber":"384","lexNumber":292,"lexYear":2013,"lexType":"PREDPIS_ZAKON"}],"flags":[]},"styles":[{"localId":0,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":false,"italic":false},{"localId":1,"alignment":"LEFT","hasSpaceBefore":false,"hasSpaceAfter":false,"bold":true,"italic":false}]}