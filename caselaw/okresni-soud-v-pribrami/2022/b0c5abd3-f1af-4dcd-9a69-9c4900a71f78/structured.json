      "texts": [
        {
          "text": "V písemném vyhotovení rozsudku Okresního soudu v Příbrami č.j. 16 C 136/2022-54 se opravuje nesprávně uvedené datum vyhlášení rozsudku„ 25. srpna 2022“ tak, že správně zní„ 31. srpna 2022“.",
          "anonStyle": "NONE"
